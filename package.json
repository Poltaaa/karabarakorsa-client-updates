{
  "name": "karabarakorsa-client",
  "productName": "Karabarakorsa AFK Client",
  "version": "1.15.19",
  "description": "Karabarakorsa AFK Client - Professional Minecraft AFK Client for Windows",
  "main": "src/main/main.js",
  "author": "Karabarakorsa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "postinstall": "electron-builder install-app-deps",
    "verify": "node scripts/verify.js",
    "test:network": "node scripts/test-network-local.js",
    "test:performance": "node scripts/test-index-local.js",
    "test:build": "node scripts/test-build-local.js && node scripts/test-build-placement.js",
    "test:wart": "node scripts/test-nether-wart.js && node scripts/test-wart-local.js",
    "test:build-network": "node scripts/test-build-network.js",
    "test:planner": "node scripts/test-build-planner.js",
    "test:travel": "node scripts/test-build-travel.js && node scripts/test-build-travel-local.js",
    "test:safety": "node scripts/test-packet-safety.js",
    "test:build-large": "node scripts/test-build-large.js",
    "test:movement": "node scripts/test-movement-watch.js",
    "test:movement-network": "node scripts/test-movement-network.js",
    "test:rows": "node scripts/test-build-rows.js",
    "test:rows-network": "node scripts/test-build-rows-network.js",
    "test:pace": "node scripts/test-build-pace.js",
    "test:lastgap": "node scripts/test-build-lastgap.js",
    "test:natural-stops": "node scripts/test-build-natural-stop.js",
    "test:surfaces": "node scripts/test-build-surface-version.js",
    "test:input": "node scripts/test-movement-input.js",
    "test:input-network": "node scripts/test-build-input-network.js",
    "test:edge": "node scripts/test-build-edge.js",
    "test:strafe": "node scripts/test-build-strafe.js",
    "test:edge-network": "node scripts/test-build-edge-network.js",
    "test:crop-rows": "node scripts/test-build-crop-rows.js",
    "test:server-speed": "node scripts/test-movement-attributes.js",
    "test:wart-rows-network": "node scripts/test-wart-rows-network.js",
    "test:attribute-packet": "node scripts/test-attribute-packet.js",
    "test:speed-lock-network": "node scripts/test-build-speed-lock-network.js",
    "test:row-transition": "node scripts/test-build-row-transition.js",
    "test:solid-pace": "node scripts/test-build-solid-pace-network.js",
    "test:escape-gaps": "node scripts/test-build-escape-gaps.js",
    "test:materials-stop": "node scripts/test-build-materials-stop.js",
    "test:permission": "node scripts/test-build-permission.js",
    "test:client-ticks": "node scripts/test-client-ticks.js",
    "test:refill-terminal": "node scripts/test-build-refill-terminal.js",
    "test:solid-pattern": "node scripts/test-build-solid-pattern.js",
    "test:pattern-resume": "node scripts/test-build-pattern-resume.js",
    "test:column-step": "node scripts/test-build-column-step.js"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.5",
    "minecraft-protocol": "1.68.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "msmc": "^5.0.5",
    "prismarine-auth": "^2.5.0",
    "socks": "^2.8.3"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.karabarakorsa.afkclient",
    "productName": "Karabarakorsa AFK Client",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/tray16.png",
        "to": "tray16.png"
      },
      {
        "from": "resources/tor",
        "to": "tor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Karabarakorsa AFK Client",
      "artifactName": "Karabarakorsa-Setup-${version}-132.${ext}"
    },
    "portable": {
      "artifactName": "Karabarakorsa-Portable-${version}-132.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Poltaaa/karabarakorsa-client-updates.git"
  },
  "bugs": {
    "url": "https://github.com/Poltaaa/karabarakorsa-client-updates/issues"
  },
  "homepage": "https://github.com/Poltaaa/karabarakorsa-client-updates#readme"
}
